<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY MANIFEST OVERLAY.

  It exists for one attribute. The debug build talks to the Stage 6 stack over
  `http://10.0.2.2:3000`, and Android has refused cleartext by default since
  API 28 - so without this the app cannot reach its own development backend and
  reports "No internet connection" on a device that is online.

  The release build never sees this file, so release keeps the platform default
  and `res/xml/network_security_config.xml` under `src/debug/` narrows even the
  debug permission to the three loopback addresses a development machine can be.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
