# =====================================================================
# Mohalla - environment template
# =====================================================================
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# EVERY variable is documented in docs/foundation/10-environment-variables.md.
# This file contains NO real credential - the values below are either local
# development defaults or obvious placeholders.
#
# The API and worker validate this contract at startup with zod and REFUSE TO
# START when a required variable is missing. That is deliberate: a process that
# boots with half its configuration fails later, under load, in a way that is
# much harder to diagnose.
# =====================================================================

# ---------------------------------------------------------------- environment
NODE_ENV=development
LOG_LEVEL=debug

# ----------------------------------------------------------------------- api
PORT=3000

# ------------------------------------------------------------------ database
# Local development points at the Docker Compose service.
#
# In staging and production this is the runtime_app role - NOT the owner and
# NOT migration_owner. The API must not be able to run DDL.
DATABASE_URL=postgres://runtime_app:CHANGE_ME@127.0.0.1:5432/mohalla
DATABASE_POOL_MAX=10

# Used only by `npm run db:migrate`. Held by a human or by CI, never by a
# running application process.
MIGRATION_DATABASE_URL=postgres://migration_owner:CHANGE_ME@127.0.0.1:5432/mohalla

# Used only by `npm run db:roles`, once, to create the four roles. This is the
# cluster owner credential. It is not stored in any application environment.
ADMIN_DATABASE_URL=postgres://mohalla_owner:mohalla_local_dev_only@127.0.0.1:5432/mohalla

# Role passwords, consumed by scripts/apply-roles. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ROLE_MIGRATION_OWNER_PASSWORD=CHANGE_ME
ROLE_RUNTIME_APP_PASSWORD=CHANGE_ME
ROLE_RUNTIME_WORKER_PASSWORD=CHANGE_ME
ROLE_READ_ONLY_SUPPORT_PASSWORD=CHANGE_ME

# -------------------------------------------------------------------- worker
PGBOSS_SCHEMA=pgboss

# =====================================================================
# NOT PART OF THE STAGE 5 FOUNDATION
# =====================================================================
# The variables below are listed so the shape of the deployed contract is
# visible, and so nobody invents a different name later. The foundation does
# NOT read them and no feature that uses them exists yet.
#
# Filling these in does not enable anything.
# ---------------------------------------------------------------------
# SMS - provider chosen after Pakistani network coverage testing (DEP-002).
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=
#
# Object storage - S3-compatible, private quarantine bucket separate from the
# public bucket (ADR-013).
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET_QUARANTINE=
# STORAGE_BUCKET_PUBLIC=
#
# Push notifications.
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=
#
# Password hashing - Argon2id parameters are benchmarked on the chosen host
# before launch and recorded, not guessed (Stage 4 section 17, EPIC-00).
# ARGON2_MEMORY_KIB=
# ARGON2_ITERATIONS=
# ARGON2_PARALLELISM=
#
# Peppers. Rotating these invalidates the ban list, so they are generated once
# and held in the provider secret store with no copy anywhere else.
# IDENTIFIER_HASH_PEPPER=
# IP_HASH_PEPPER=

# --------------------------------------------------------------- observability
# Bearer token for GET /health/metrics (NFR-OBS-003). UNSET MEANS THE ROUTE IS
# OFF - it never defaults to public. Not an admin session: an uptime checker
# cannot log in, and OD-020 means there is no administrator to log in as.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
METRICS_TOKEN=CHANGE_ME

# Where `npm run db:backup` writes dumps (SEC-026). In a deployed environment
# this MUST be a location separate from the primary system, and SEC-027
# requires it to be encrypted at rest.
BACKUP_DIR=.backups

# The clean database a restore rehearsal restores INTO (REL-007). Must never be
# the primary; the rehearsal script refuses when it matches ADMIN_DATABASE_URL.
RESTORE_TARGET_URL=postgres://mohalla_owner:CHANGE_ME@127.0.0.1:5432/mohalla_rehearsal
