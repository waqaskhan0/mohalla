{
  "name": "@mohalla/db",
  "version": "0.0.0",
  "private": true,
  "description": "Mohalla database foundation - roles, migrations, append-only audit log.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "migrate": "node-pg-migrate up -m migrations -j js",
    "migrate:down": "node-pg-migrate down -m migrations -j js",
    "migrate:status": "node scripts/migration-status.mjs",
    "roles": "node scripts/apply-roles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "reset": "node scripts/reset.mjs",
    "provision-admin": "node scripts/provision-admin.mjs",
    "restore:rehearsal": "node scripts/restore-rehearsal.mjs"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.7.0",
    "vitest": "4.1.11"
  }
}
